# ========================================================================
# Mahakan POS — Environment Variables Template
# ========================================================================
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it's gitignored.
#
# For production (Vercel), set these in Project → Settings → Environment
# Variables. Do NOT include quotes around values in Vercel UI.
# ========================================================================

# --- DATABASE (Neon Postgres) ------------------------------------------
# Use the POOLED connection string (ends with `-pooler.../neondb`).
# Get from: https://console.neon.tech → project → Connect → Pooled
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- AUTH (Auth.js v5) -------------------------------------------------
# Generate locally with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64
AUTH_TRUST_HOST=true

# --- APP CONFIG --------------------------------------------------------
# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Production: NEXT_PUBLIC_APP_URL=https://mahakan-pos.vercel.app

# --- SEED DATA (used by `npm run db:seed`) -----------------------------
# First Owner user created during initial seed.
# After first login, Owner can create Manager & Staff users via admin UI.
SEED_OWNER_NAME=Rama Saputra
SEED_OWNER_EMAIL=rama.activity98@gmail.com
SEED_OWNER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHAR

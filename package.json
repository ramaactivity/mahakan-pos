{
  "name": "mahakan-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:tier2": "E2E_INCLUDE_TIER2=1 PLAYWRIGHT_BASE_URL=http://localhost:3001 playwright test e2e/tier2",
    "test:e2e:tablet": "E2E_INCLUDE_TIER2=1 PLAYWRIGHT_BASE_URL=http://localhost:3001 playwright test --project=tablet-galaxy-a7-lite e2e/tier2/pos-smoke.spec.ts e2e/tier2/pos-shift-flow.spec.ts e2e/tier2/pos-transaction.spec.ts e2e/tier2/open-bill.spec.ts e2e/tier2/riwayat-smoke.spec.ts e2e/tier2/correction-chain.spec.ts e2e/tier2/transaction-correction.spec.ts",
    "test:e2e:admin-tablet": "E2E_INCLUDE_TIER2=1 PLAYWRIGHT_BASE_URL=http://localhost:3001 playwright test --project=tablet-galaxy-a7-lite e2e/tier2/admin-navigation.spec.ts e2e/tier2/admin-sections-deep.spec.ts e2e/tier2/inventory-flow.spec.ts e2e/tier2/menu-section.spec.ts e2e/tier2/stock-movements.spec.ts e2e/tier2/reconciliation-deep.spec.ts e2e/tier2/operational-modules.spec.ts e2e/tier2/aggregator-import.spec.ts e2e/tier2/purchase-requests.spec.ts e2e/tier2/printer-pairing.spec.ts e2e/tier2/payroll-period.spec.ts e2e/tier2/settlement-import-deep.spec.ts e2e/tier2/console-errors-baseline.spec.ts",
    "test:e2e:journal-verify": "E2E_INCLUDE_TIER2=1 PLAYWRIGHT_BASE_URL=http://localhost:3001 playwright test --project=chromium-desktop e2e/tier2/transaction-journal-verify.spec.ts",
    "test:e2e:both-projects": "E2E_INCLUDE_TIER2=1 PLAYWRIGHT_BASE_URL=http://localhost:3001 playwright test --project=chromium-desktop --project=tablet-galaxy-a7-lite e2e/tier2",
    "dev:e2e": "tsx scripts/dev-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:safe": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "inventory:template": "tsx scripts/inventory-template.ts",
    "inventory:export": "tsx --env-file-if-exists=.env.local scripts/inventory-export.ts",
    "inventory:import": "tsx --env-file-if-exists=.env.local scripts/inventory-import.ts",
    "seed:mock-stock": "tsx --env-file-if-exists=.env.local scripts/seed-mock-stock.ts",
    "seed:default-promos": "tsx --env-file-if-exists=.env.local scripts/seed-default-promos.ts",
    "seed:suppliers-and-sections": "tsx --env-file-if-exists=.env.local scripts/seed-suppliers-and-sections.ts",
    "seed:bulk-ingredients": "tsx --env-file-if-exists=.env.local scripts/seed-bulk-ingredients.ts",
    "seed:accounts": "tsx --env-file-if-exists=.env.local scripts/seed-accounts.ts",
    "accounting:smoke": "tsx --env-file-if-exists=.env.local scripts/accounting-smoke.ts",
    "drive:auth": "tsx --env-file-if-exists=.env.local scripts/google-drive-oauth.ts",
    "wipe:test-data": "tsx --env-file-if-exists=.env.local scripts/wipe-test-data.ts",
    "wipe:close-shifts": "tsx --env-file-if-exists=.env.local scripts/close-all-shifts.ts"
  },
  "dependencies": {

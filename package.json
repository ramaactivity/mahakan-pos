    "@tanstack/react-virtual": "^3.13.24",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.2",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "google-auth-library": "^10.6.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.9.0",
    "nanoid": "^5.1.9",
